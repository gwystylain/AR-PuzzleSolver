<?xml version="1.0" encoding="utf-8"?>
<!--
  Only Spellinator uses the network, and only over TLS (wss://), with one exception:
  plain ws:// to the phone itself. Traffic to localhost never leaves the phone, so there is
  nothing on it to read, and it is how a release build is tested against a server on a
  laptop: `adb reverse tcp:8080 tcp:8080` and a server address of ws://localhost:8080.
  The debug build's copy of this file allows cleartext anywhere, for a server on the LAN.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
